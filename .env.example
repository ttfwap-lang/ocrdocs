# OCRDocs environment example
# Copy to .env for local development. Do not commit real secrets.

# App server (this machine: npm run dev / npm start)
# Optional in development; required only if using Gemini chat features.
GEMINI_API_KEY=

# Optional. development | production | test. Default: development.
NODE_ENV=development

# Optional. HTTP port for the Express/Vite server. Default: 3000.
PORT=3000

# Optional. Bind address. Default: 0.0.0.0 so the DGX worker can reach this machine over the network.
HOST=0.0.0.0

# Optional. SQLite database path. Default: data/app.db.
DATABASE_PATH=data/app.db

# Optional. Private upload storage root. Default: storage/private.
STORAGE_ROOT=storage/private

# Required in production if JWT route guards are enabled. Minimum 16 characters.
JWT_SECRET=

# Optional. Graceful shutdown timeout in milliseconds. Default: 10000.
SHUTDOWN_TIMEOUT_MS=10000

# Required for DGX worker endpoints. Use the same value on this app server and the DGX worker.
DGX_WORKER_TOKEN=

# DGX worker (separate machine: scripts/dgx_worker.py)
# Required. Network URL the DGX machine can reach for this app server; do not use localhost from the DGX.
OCRDOCS_SERVER_URL=http://THIS_MACHINE_LAN_ADDRESS:3000

# Optional. Worker claim polling interval in seconds. Default: 5.
OCRDOCS_POLL_INTERVAL_SECONDS=5

# Optional. Maximum OCR passes per document. Default: 10.
OCRDOCS_MAX_PASSES=10

# Optional. DGX worker download/cache directory. Default: system temp/ocrdocs_worker.
OCRDOCS_WORKER_DOWNLOAD_DIR=/mnt/nvme/ocrdocs_worker

# DGX scripts / diagnostics
# Optional. Overrides OCRDOCS_SERVER_URL + /api/dgx/telemetry-report for check_dgx_codebase.sh.
REPORT_SERVER_URL=

# Optional. Overrides /mnt/nvme/ocr_pipeline for ocr_spark_engine.py and diagnostics.
NVME_ROOT=/mnt/nvme/ocr_pipeline

# Optional. Enables GPL-screened Surya OCR for local research only. Default: false.
OCRDOCS_ENABLE_RESEARCH_ENGINES=false
