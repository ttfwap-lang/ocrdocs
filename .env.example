# OCRDocs environment example
# Copy to .env for local development. Do not commit real secrets.

# App server (this machine: npm run dev / npm start)
# Optional in development; required only if using Gemini chat features.
GEMINI_API_KEY=

# Optional. development | production | test. Default: development.
NODE_ENV=development

# Optional. HTTP port for the Express/Vite server. Default: 3000.
PORT=3000

# Optional. Bind address. Default: 0.0.0.0 so the DGX worker can reach this machine over the network.
HOST=0.0.0.0

# Optional. SQLite database path. Default: data/app.db.
DATABASE_PATH=data/app.db

# Optional. Private upload storage root. Default: storage/private.
STORAGE_ROOT=storage/private

# Required in production if JWT route guards are enabled. Minimum 16 characters.
JWT_SECRET=

# Optional. Graceful shutdown timeout in milliseconds. Default: 10000.
SHUTDOWN_TIMEOUT_MS=10000

# Required for the DGX worker endpoints (/api/jobs/claim, /api/jobs/:id/file,
# /api/jobs/:id/result), the telemetry endpoint (/api/dgx/telemetry-report) and
# script download (/api/scripts/:name). Use the same value here and on the DGX.
# If unset, all of those return 503 — they fail closed rather than standing open.
DGX_WORKER_TOKEN=

# Optional. How long a claimed job may sit in 'processing' before its worker is
# presumed dead and the job returns to the queue. Must comfortably exceed the
# slowest expected document. Default: 900.
OCRDOCS_WORKER_LEASE_SECONDS=900

# Optional. How many times a job may be claimed before it is failed for good,
# so a document that reliably kills workers cannot retry forever. Default: 3.
OCRDOCS_MAX_JOB_ATTEMPTS=3

# Optional. Cap on document text fed to the 99 field matchers. Matching runs
# synchronously on the request thread, so an unbounded document would stall
# every other request. Default: 2000000.
OCRDOCS_MAX_EXTRACTION_TEXT_CHARS=2000000

# DGX worker (separate machine: scripts/dgx_worker.py)
# Required. Network URL the DGX machine can reach for this app server; do not use localhost from the DGX.
OCRDOCS_SERVER_URL=http://THIS_MACHINE_LAN_ADDRESS:3000

# Optional. Worker claim polling interval in seconds. Default: 5.
OCRDOCS_POLL_INTERVAL_SECONDS=5

# Optional. Maximum OCR passes per document. Default: 10.
OCRDOCS_MAX_PASSES=10

# Optional. DGX worker download/cache directory. Default: system temp/ocrdocs_worker.
OCRDOCS_WORKER_DOWNLOAD_DIR=/mnt/nvme/ocrdocs_worker

# DGX scripts / diagnostics
# Optional. Overrides OCRDOCS_SERVER_URL + /api/dgx/telemetry-report for check_dgx_codebase.sh.
REPORT_SERVER_URL=

# Optional. Overrides /mnt/nvme/ocr_pipeline for ocr_spark_engine.py and diagnostics.
NVME_ROOT=/mnt/nvme/ocr_pipeline

# Optional. Enables GPL-screened Surya OCR for local research only. Default: false.
OCRDOCS_ENABLE_RESEARCH_ENGINES=false

# Optional. Enables the TrOCR handwriting pass. Permissively licensed; gated
# for model download size and VRAM cost, not for licensing. Default: false.
OCRDOCS_ENABLE_HANDWRITING_ENGINE=false

# --- Batch import (ocr.local) ------------------------------------------------
# Enables the /api/imports batch-import endpoints. The import flow stages files
# into OCRDOCS_QUEUED_DIR, runs OCRDOCS_PREPARSE_SCRIPT against it (TARGET_DIR
# is passed as the staged dir via $1), then renames the staged dir to a
# timestamped folder under OCRDOCS_PARSED_DIR and enqueues one OCR job per file.
# Optional. Default: false.
OCRDOCS_IMPORT_ENABLED=false

# Hostname served over mDNS (avahi publishes this alias alongside ocrdocs.local).
# Optional. Default: ocr.local.
OCRDOCS_HOSTNAME=ocr.local

# UNC/Windows root for the import workspace. On a Linux gx10 host point this at
# the mounted share or an alternate root (e.g. /opt/ocr/workbench).
# Optional. Default: C:\NVIDIA-Workbench\ocr.
OCRDOCS_IMPORT_ROOT=C:\NVIDIA-Workbench\ocr

# Queued (pre-parse input) and parsed (pre-parse output) directories. The server
# resolves these relative to OCRDOCS_IMPORT_ROOT unless overridden with absolute paths.
# Optional. Defaults: <OCRDOCS_IMPORT_ROOT>\queued and ...\parsed.
OCRDOCS_QUEUED_DIR=
OCRDOCS_PARSED_DIR=

# Path to the pre-parse bash script that cleans/dedups/extracts the staged dir.
# Optional. Default: <repo>\scripts\pre-parse.sh.
OCRDOCS_PREPARSE_SCRIPT=

# How to launch the pre-parse script. linux|wsl|bash|node. "node" exists for tests.
# Optional. Default: auto (linux on POSIX, wsl on Windows).
OCRDOCS_PREPARSE_SHELL=auto

# Bearer token required by POST /api/imports. Separate from DGX_WORKER_TOKEN.
# Optional. Default: unset (imports disabled).
OCRDOCS_IMPORT_TOKEN=

# Safety caps on a single import batch.
# Optional. Defaults: 500 files / 500 MB total.
OCRDOCS_IMPORT_MAX_FILES=500
OCRDOCS_IMPORT_MAX_TOTAL_MB=500
