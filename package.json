{
  "name": "ocrdocs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "node --test --test-timeout=30000 tests/*.test.mjs",
    "test:unit": "node --test --test-timeout=30000 tests/australianValidation.test.mjs tests/ocrEngine.test.mjs tests/bankFields.test.mjs tests/stage3Architecture.test.mjs tests/stage4DemoSeparation.test.mjs tests/stage5Dependencies.test.mjs tests/stage6Startup.test.mjs",
    "test:integration": "node --test --test-timeout=30000 tests/autonomyHost.test.mjs tests/dgxJobEndpoints.test.mjs",
    "test:worker": "node --test --test-timeout=30000 tests/stage7TestIntegrity.test.mjs",
    "test:browser": "node --test --test-timeout=30000 tests/browser/suiteContract.test.mjs",
    "test:deployment": "node --test --test-timeout=30000 tests/deployment/suiteContract.test.mjs",
    "test:governance": "node --test --test-timeout=30000 tests/autonomy.test.mjs tests/stages.test.mjs",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:worker && npm run test:browser && npm run test:deployment && npm run test:governance",
    "autonomy": "node scripts/autonomy/runner.mjs"
  },
  "dependencies": {
    "@google/genai": "2.22.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "5.2.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "0.546.0",
    "motion": "12.43.0",
    "multer": "2.4.0",
    "pdf-parse": "2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.2",
    "autoprefixer": "10.5.6",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
